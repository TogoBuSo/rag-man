# Django (set real values in .env — never commit .env)
DJANGO_SECRET_KEY=change-me-generate-a-strong-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.example.com,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example.com
APP_PORT=8085
DJANGO_TIME_ZONE=Africa/Johannesburg

# Encryption key for TenantProviderConfig.encrypted_api_keys (32-byte url-safe base64 Fernet key)
FIELD_ENCRYPTION_KEY=change-me-generate-with-fernet-generate-key

# PostgreSQL + pgvector 0.8+
POSTGRES_DB=rag_platform
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Storage: primary mechanism is local temp directory on the webserver
LOCAL_STORAGE_TEMP_DIR=/tmp/rag_man_uploads
CLEANUP_TEMP_FILES_AFTER_PROCESSING=true

# Optional AWS S3 / S3-compatible storage (install with `pip install -e ".[s3]"`)
USE_S3_STORAGE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1

# LiteLLM Defaults (set secrets & private endpoints in .env only)
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEFAULT_EMBEDDING_DIMENSIONS=1536
DEFAULT_EMBEDDING_API_BASE=
DEFAULT_EMBEDDING_API_KEY=
DEFAULT_EXTRACTION_MODEL=gpt-4o-mini
DEFAULT_SYNTHESIS_MODEL=gpt-4o-mini
DEFAULT_RERANK_MODEL=cohere/rerank-english-v3.0
LLM_REQUEST_TIMEOUT=60

# Provider Credentials & Endpoints
OPENAI_API_KEY=

# Generic OpenAI-compatible endpoint (use model prefix: openai_compatible/<model>)
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_API_KEY=

# Eden AI (edenai.io — use model prefix: edenai/<provider>/<model> or openai_compatible/<model>)
EDENAI_API_BASE=https://api.edenai.run/v2/llm
EDENAI_API_KEY=

# Ollama with optional HTTP Basic Auth (use model prefix: ollama/<model> or ollama_chat/<model>)
OLLAMA_API_BASE=
OLLAMA_BASIC_AUTH_USERNAME=
OLLAMA_BASIC_AUTH_PASSWORD=
